# HYDRA ENVIRONMENT VARIABLES EXAMPLE

# Supabase Credentials (Optional for local offline mode, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push VAPID Keys (Generate via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# Email Notification Provider (Resend API or SMTP)
EMAIL_FROM=Hydra Hydration <reminders@hydra.app>
RESEND_API_KEY=re_123456789...
# SMTP Fallback (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Phone SMS Notification Provider (Twilio API)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+18005550199

